PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Supabase — PostgreSQL connection string
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Cryptorefills — gift card fulfillment (Partner ID from your account settings)
CRYPTOREFILLS_PARTNER_ID=

# Base chain — Cryptorefills settlement destination
BASE_RPC_URL=https://mainnet.base.org
BASE_CHAIN_ID=8453
USDC_TOKEN_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913

# Robinhood Chain — user payment origin (USDG default, ETH optional)
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
ROBINHOOD_CHAIN_ID=4663
ROBINHOOD_USDG_ADDRESS=0x5fc5360D0400a0Fd4f2af552ADD042D716F1d168

# Treasury wallet — receives the 1% Relay platform fee
PAYMENT_WALLET_ADDRESS=

# Relay Link — cross-chain solver API (get a key at https://relay.link)
RELAY_API_KEY=

# Groq — AI shopping assistant (POST /chat), OpenAI-compatible tool calling
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# Resend — transactional email (order confirmations etc.)
RESEND_API_KEY=
EMAIL_FROM=cards@usdbt.us

JWT_SECRET=
